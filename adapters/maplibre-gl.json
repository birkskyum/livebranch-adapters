{
    "about": "Builds maplibre-gl-js from src. Its generated sources are not in git, so three generators run first. The Unicode data and the stylesheet come from the npm release, because their generators cannot run in a browser. The files under dist stand in for the bundles, so that the example pages in test/examples run as they are. The worker is a module next to the source that looks for it.",
    "entry": "demo.ts",
    "setup": [
        "node build/generate-shaders.ts",
        "node build/generate-struct-arrays.ts",
        "node build/generate-style-code.ts"
    ],
    "prebuilt": [
        {
            "files": [
                "src/util/unicode_properties.g.ts"
            ],
            "inputs": [
                "build/generate-unicode-data.ts"
            ]
        },
        {
            "files": [
                "dist/maplibre-gl.css"
            ],
            "inputs": [
                "src/css/maplibre-gl.css"
            ]
        }
    ],
    "alias": {
        "maplibre-gl": "./src/index.ts"
    },
    "entries": [
        "src/util/maplibre-gl-worker.mjs"
    ],
    "files": {
        "src/util/maplibre-gl-worker.mjs": [
            "import '../source/worker.ts';"
        ],
        "dist/maplibre-gl.mjs": [
            "export * from '../src/index.ts';"
        ],
        "dist/maplibre-gl-dev.mjs": [
            "export * from '../src/index.ts';"
        ],
        "demo.ts": [
            "import * as maplibregl from 'maplibre-gl';",
            "",
            "const map = new maplibregl.Map({",
            "    container: 'map',",
            "    style: 'https://demotiles.maplibre.org/style.json',",
            "    center: [10, 50],",
            "    zoom: 3,",
            "    hash: true,",
            "});",
            "map.addControl(new maplibregl.NavigationControl());"
        ]
    },
    "template": [
        "<!doctype html>",
        "<html lang=\"en\">",
        "<head>",
        "<meta charset=\"utf-8\">",
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
        "<title>MapLibre GL JS</title>",
        "<link rel=\"stylesheet\" href=\"./dist/maplibre-gl.css\">",
        "<style>html, body, #map { margin: 0; height: 100%; }</style>",
        "</head>",
        "<body>",
        "<div id=\"map\"></div>",
        "<!--entry-->",
        "</body>",
        "</html>"
    ]
}
